{
	"name": "hotash/comments",
	"description": "Comment Automation Module (Facebook & Instagram) for ReplyNat",
	"type": "library",
	"version": "1.0",
	"license": "proprietary",
	"require": {
		"filament/filament": "^5.0"
	},
	"autoload": {
		"psr-4": {
			"Hotash\\Comments\\": "src/",
			"Hotash\\Comments\\Tests\\": "tests/",
			"Hotash\\Comments\\Database\\Factories\\": "database/factories/",
			"Hotash\\Comments\\Database\\Seeders\\": "database/seeders/"
		}
	},
	"minimum-stability": "stable",
	"extra": {
		"laravel": {
			"providers": [
				"Hotash\\Comments\\Providers\\CommentsServiceProvider"
			]
		}
	}
}
